# Local only: choose a password before starting Compose. Never commit .env.
DB_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=8080
API_DOCS_ENABLED=true
IDENTITY_URL=http://localhost:8081
IDENTITY_DOCKER_URL=http://host.docker.internal:8081
IDENTITY_SERVICE_KEY=
JWT_PUBLIC_KEY=file:.local/keys/identity-public.pem
IDENTITY_PUBLIC_KEY_PATH=./.local/keys/identity-public.pem
