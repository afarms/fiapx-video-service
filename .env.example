# Local only: choose a password before starting Compose. Never commit .env.
DB_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=8080
SERVER_PORT=8080
API_DOCS_ENABLED=true
IDENTITY_URL=http://localhost:8081
IDENTITY_DOCKER_URL=http://host.docker.internal:8081
IDENTITY_SERVICE_KEY=
JWT_PUBLIC_KEY=file:.local/keys/identity-public.pem
IDENTITY_PUBLIC_KEY_PATH=./.local/keys/identity-public.pem

# Upload on the host: use the dedicated role profile in ~/.aws/config, without copying keys here.
UPLOAD_ENABLED=false
UPLOAD_AWS_PROFILE=fiapx-video-local
AWS_REGION=us-east-1
MEDIA_BUCKET_NAME=fiapx-media-files
PROCESSING_QUEUE_URL=
# Keep publication off until a consumer is ready or during an explicitly controlled check.
UPLOAD_PUBLISHER_ENABLED=false
# Reconcile accepted, nonterminal videos six hours after their last successful publication.
PROCESSING_RECONCILE_ENABLED=false
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_TEMP_DIRECTORY=.local/uploads
UPLOAD_CONCURRENCY=2
UPLOAD_DISK_RESERVE_BYTES=500000000
UPLOAD_LEASE_SECONDS=300

# Processing results consumer (disabled until explicitly configured).
PROCESSING_RESULTS_ENABLED=false
VIDEOS_EVENTS_QUEUE_URL=

# Full authenticated ZIP download; disabled until explicitly configured.
DOWNLOAD_ENABLED=false
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_LEASE_SECONDS=120
DOWNLOAD_HEARTBEAT_SECONDS=30
DOWNLOAD_MAXIMUM_SECONDS=1800
